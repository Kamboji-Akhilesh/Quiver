<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Quiver AI voice input (speech-to-text). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Bank-SMS expense capture (on-device only; non-bank senders are never parsed). -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Calendar exact-time alerts. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Keep reminder alarms firing on aggressive (OEM) battery managers. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenshotCleaner">

        <!-- UI Activities -->
        <!-- Redesigned single-surface hub is the launcher. -->
        <!-- adjustResize is REQUIRED for imePadding() to work: without it the
             window PANS when the keyboard opens, and bottom-sheet buttons end
             up hidden under the IME (the recurring "vanishing button" bug). -->
        <!-- singleTask so shortcut/share deep links reuse the running shell via
             onNewIntent instead of stacking a second copy of the whole app. -->
        <activity
            android:name=".ui.shell.QuiverActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ScreenshotCleaner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Receives ACTION_SEND so shared text/images flow into Quiver: text
             becomes a note / task / expense / AI question, images get a
             scheduled screenshot cleanup. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ScreenshotCleaner.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Legacy bento hub, retained while screens migrate into the shell. -->
        <activity
            android:name=".calendar.EventCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.ScreenshotCleaner"/>
        <receiver
            android:name=".calendar.alert.AlertReceiver"
            android:exported="false"/>
        <receiver
            android:name=".calendar.alert.AlertActionReceiver"
            android:exported="false"/>
        <activity
            android:name=".screenshots.ui.DeleteConfirmActivity"
            android:theme="@style/Theme.ScreenshotCleaner.Dialog"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""/>
        <activity
            android:name=".screenshots.ui.EditDelayActivity"
            android:theme="@style/Theme.ScreenshotCleaner.Share"
            android:excludeFromRecents="true"
            android:taskAffinity=""/>

        <!-- Home-screen widgets (Glance) -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:label="@string/widget_agenda_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda" />
        </receiver>
        <receiver
            android:name=".widgets.QuickActionsWidgetReceiver"
            android:label="@string/widget_quick_actions_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions" />
        </receiver>
        <receiver
            android:name=".widgets.SpendWidgetReceiver"
            android:label="@string/widget_spend_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spend" />
        </receiver>

        <!-- Broadcast Receivers -->
        <receiver android:name=".screenshots.receiver.CancelReceiver"/>
        <receiver
            android:name=".screenshots.receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <!-- App updates/reinstalls kill the monitor service; restart it. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Services -->
        <!-- WorkManager's foreground service needs an explicit type on API 34+
             for the model-download worker's progress notification. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <service
            android:name=".screenshots.service.ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Runs Quiver AI agent tasks so they finish even if the app is closed. -->
        <service
            android:name=".ai.agent.AiAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Auto-captures UPI/bank payment notifications into Expenses. Works
             only after the user grants notification access; all parsing stays
             on-device. -->
        <service
            android:name=".expenses.capture.PaymentCaptureService"
            android:exported="false"
            android:label="Quiver expense capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Bank-SMS expense capture: SMS_RECEIVED only schedules an inbox scan (SmsCapture). -->
        <receiver
            android:name=".expenses.capture.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Focus: Shorts/Reels blocker. Only sees YouTube + Instagram (see focus_service.xml). -->
        <service
            android:name=".focus.FocusService"
            android:exported="false"
            android:label="Quiver Focus (Shorts &amp; Reels blocker)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_service" />
        </service>

    </application>

</manifest>