    <!-- Onboarding -->
    <string name="onboarding_skip">தவிர்</string>
    <string name="onboarding_p1_title">எல்லாம் உங்கள் ஃபோனில்</string>
    <string name="onboarding_p1_body">ஸ்கிரீன்ஷாட், கரன்சி, காலெண்டர், குறிப்புகள், செலவுகள் — ஒரே உதவியாளரால் இணைக்கப்பட்ட சிறிய கருவிகள். கணக்கு இல்லை, கிளவுட் இல்லை: உங்கள் தரவு இந்த சாதனத்தை விட்டு வெளியேறாது.</string>
    <string name="onboarding_p2_title">உண்மையிலேயே உதவும் அலர்ட்கள்</string>
    <string name="onboarding_p2_body">Quiver நினைவூட்டல்களுக்கு உங்களை அழைக்கும், புதிய ஸ்கிரீன்ஷாட்களை சுத்தம் செய்ய முன்வரும், பேமெண்ட் நோட்டிஃபிகேஷனில் இருந்து UPI செலவுகளை பதிவு செய்யும். இதற்கு முன் Android-க்கு உங்கள் அனுமதி தேவை.</string>
    <string name="onboarding_p3_title">உங்கள் சாதனத்திலேயே இயங்கும் AI</string>
    <string name="onboarding_p3_body">%1$s (%2$s) \"நாளை மாலை\" போன்ற நினைவூட்டல்களை ஆங்கிலம், हिन्दी, বাংলা, தமிழ், తెలుగు, मराठी-ல் கையாளும் — முழுவதும் ஆஃப்லைன். இப்போது அல்லது பிறகு AI பட்டனில் இருந்து நிறுவவும்.</string>
    <string name="onboarding_continue">தொடரவும்</string>
    <string name="onboarding_allow_notifications">நோட்டிஃபிகேஷனை அனுமதி</string>
    <string name="onboarding_not_now">இப்போது வேண்டாம்</string>
